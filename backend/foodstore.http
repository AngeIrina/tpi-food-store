# Pruebas de la API con REST Client (VS Code).
# Ejecutar en orden, con la base recién cargada con `python -m app.db.seed`.
# REST Client guarda la cookie del login y la envía en las peticiones siguientes.

@baseUrl = http://localhost:8000/api/v1

### ===== AUTH ===== Perfil sin sesión -> 401
GET {{baseUrl}}/auth/me

### Registro de un cliente -> 201
# @name nuevo
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "angela",
  "full_name": "Angela Ramos",
  "email": "angela@mail.com",
  "password": "Angela1234!"
}

### Registro con username repetido -> 409
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "angela",
  "full_name": "Otra Persona",
  "email": "otra@mail.com",
  "password": "Otra12345!"
}

### Registro con contraseña corta -> 422
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "corta",
  "full_name": "Clave Corta",
  "email": "corta@mail.com",
  "password": "123"
}

### Login con contraseña incorrecta -> 401
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=angela&password=incorrecta

### Login del cliente (guarda la cookie access_token) -> 200
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=angela&password=Angela1234!

### Perfil del usuario logueado -> 200
GET {{baseUrl}}/auth/me

### Crear categoría siendo user -> 403
POST {{baseUrl}}/categorias
Content-Type: application/json

{
  "nombre": "No autorizada"
}

### Listar usuarios siendo user -> 403
GET {{baseUrl}}/admin/usuarios

### ===== CATÁLOGO (público) ===== Listar categorías activas -> 200
GET {{baseUrl}}/categorias

### Listar productos paginados -> 200
GET {{baseUrl}}/productos?skip=0&limit=5

### Buscar productos por nombre -> 200
GET {{baseUrl}}/productos?search=PIZZA

### Filtrar productos por categoría y disponibilidad -> 200
GET {{baseUrl}}/productos?categoria_id=3&disponible=true

### Límite fuera de rango -> 422
GET {{baseUrl}}/productos?limit=500

### Detalle de producto con su categoría -> 200
GET {{baseUrl}}/productos/1

### ===== PEDIDOS (cliente) ===== Crear pedido -> 201
# @name pedido1
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "items": [
    { "producto_id": 1, "cantidad": 2 },
    { "producto_id": 7, "cantidad": 3 }
  ],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "Av. San Martín 1234",
  "notas": "Tocar timbre 2B"
}

### Producto repetido en el pedido -> 400
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "items": [
    { "producto_id": 1, "cantidad": 1 },
    { "producto_id": 1, "cantidad": 2 }
  ],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "Av. San Martín 1234"
}

### Stock insuficiente -> 400
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "items": [{ "producto_id": 2, "cantidad": 9999 }],
  "forma_pago": "TRANSFERENCIA",
  "direccion_entrega": "Av. San Martín 1234"
}

### Producto inexistente -> 404
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "items": [{ "producto_id": 9999, "cantidad": 1 }],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "Av. San Martín 1234"
}

### Forma de pago inválida -> 422
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "items": [{ "producto_id": 1, "cantidad": 1 }],
  "forma_pago": "TARJETA",
  "direccion_entrega": "Av. San Martín 1234"
}

### Pedido sin ítems y dirección corta -> 422
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "items": [],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "Av"
}

### Mis pedidos -> 200
GET {{baseUrl}}/pedidos

### Detalle de mi pedido -> 200
GET {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}

### Crear un segundo pedido para cancelarlo -> 201
# @name pedido2
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "items": [{ "producto_id": 4, "cantidad": 5 }],
  "forma_pago": "TRANSFERENCIA",
  "direccion_entrega": "Calle Falsa 123"
}

### Cancelar mi pedido en PENDIENTE (restituye stock) -> 200
PATCH {{baseUrl}}/pedidos/{{pedido2.response.body.$.id}}/cancelar

### Cancelar un pedido ya cancelado -> 400
PATCH {{baseUrl}}/pedidos/{{pedido2.response.body.$.id}}/cancelar

### Cambiar estado siendo user -> 403
PATCH {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}/estado
Content-Type: application/json

{
  "estado": "EN_PREPARACION"
}

### Resumen siendo user -> 403
GET {{baseUrl}}/pedidos/resumen

### Logout -> 200
POST {{baseUrl}}/auth/logout

### Perfil después del logout -> 401
GET {{baseUrl}}/auth/me

### ===== ADMIN ===== Login del admin -> 200
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password=Admin1234!

### Listar usuarios -> 200
GET {{baseUrl}}/admin/usuarios

### Crear categoría -> 201
# @name categoria
POST {{baseUrl}}/categorias
Content-Type: application/json

{
  "nombre": "Empanadas",
  "descripcion": "Al horno y fritas"
}

### Crear categoría con nombre repetido -> 409
POST {{baseUrl}}/categorias
Content-Type: application/json

{
  "nombre": "pizzas"
}

### Crear categoría con nombre corto -> 422
POST {{baseUrl}}/categorias
Content-Type: application/json

{
  "nombre": "A"
}

### Actualizar categoría (parcial) -> 200
PUT {{baseUrl}}/categorias/{{categoria.response.body.$.id}}
Content-Type: application/json

{
  "descripcion": "Empanadas caseras al horno"
}

### Actualizar categoría inexistente -> 404
PUT {{baseUrl}}/categorias/9999
Content-Type: application/json

{
  "nombre": "No existe"
}

### Crear producto -> 201
# @name producto
POST {{baseUrl}}/productos
Content-Type: application/json

{
  "nombre": "Empanada de carne",
  "descripcion": "Carne cortada a cuchillo",
  "precio_base": 1800,
  "imagen_url": "https://example.com/empanada.jpg",
  "stock": 48,
  "categoria_id": {{categoria.response.body.$.id}}
}

### Crear producto con categoría inexistente -> 404
POST {{baseUrl}}/productos
Content-Type: application/json

{
  "nombre": "Producto huérfano",
  "precio_base": 100,
  "categoria_id": 9999
}

### Crear producto con precio negativo -> 422
POST {{baseUrl}}/productos
Content-Type: application/json

{
  "nombre": "Precio inválido",
  "precio_base": -1,
  "categoria_id": 1
}

### Actualizar producto (solo el precio) -> 200
PUT {{baseUrl}}/productos/{{producto.response.body.$.id}}
Content-Type: application/json

{
  "precio_base": 1950
}

### Cambiar stock y disponibilidad -> 200
PATCH {{baseUrl}}/productos/{{producto.response.body.$.id}}/stock
Content-Type: application/json

{
  "stock": 60,
  "disponible": true
}

### Stock negativo -> 422
PATCH {{baseUrl}}/productos/{{producto.response.body.$.id}}/stock
Content-Type: application/json

{
  "stock": -5,
  "disponible": true
}

### Ver un pedido de otro usuario siendo admin -> 200
GET {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}

### Transición inválida PENDIENTE -> ENTREGADO -> 400
PATCH {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}/estado
Content-Type: application/json

{
  "estado": "ENTREGADO"
}

### Avanzar a EN_PREPARACION -> 200
PATCH {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}/estado
Content-Type: application/json

{
  "estado": "EN_PREPARACION"
}

### Avanzar a ENTREGADO -> 200
PATCH {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}/estado
Content-Type: application/json

{
  "estado": "ENTREGADO"
}

### Cancelar un pedido entregado (estado terminal) -> 400
PATCH {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}/estado
Content-Type: application/json

{
  "estado": "CANCELADO"
}

### Cancelar con el endpoint del dueño un pedido ajeno -> 403
PATCH {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}/cancelar

### Estado inexistente -> 422
PATCH {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}/estado
Content-Type: application/json

{
  "estado": "VOLANDO"
}

### Todos los pedidos filtrados por estado -> 200
GET {{baseUrl}}/pedidos?estado=ENTREGADO

### Resumen del panel -> 200
GET {{baseUrl}}/pedidos/resumen

### Pedido inexistente -> 404
GET {{baseUrl}}/pedidos/9999

### Baja lógica de producto -> 204
DELETE {{baseUrl}}/productos/{{producto.response.body.$.id}}

### Producto dado de baja -> 404
GET {{baseUrl}}/productos/{{producto.response.body.$.id}}

### Borrar de nuevo el producto dado de baja -> 404
DELETE {{baseUrl}}/productos/{{producto.response.body.$.id}}

### Baja lógica de categoría -> 204
DELETE {{baseUrl}}/categorias/{{categoria.response.body.$.id}}

### Categoría dada de baja -> 404
GET {{baseUrl}}/categorias/{{categoria.response.body.$.id}}

### Crear producto en una categoría dada de baja -> 404
POST {{baseUrl}}/productos
Content-Type: application/json

{
  "nombre": "Empanada de pollo",
  "precio_base": 1800,
  "categoria_id": {{categoria.response.body.$.id}}
}

### Desactivar al cliente -> 200
POST {{baseUrl}}/admin/usuarios/{{nuevo.response.body.$.id}}/desactivar

### Desactivarlo de nuevo (idempotente) -> 200
POST {{baseUrl}}/admin/usuarios/{{nuevo.response.body.$.id}}/desactivar

### El admin no puede desactivarse a sí mismo -> 400
POST {{baseUrl}}/admin/usuarios/1/desactivar

### Desactivar usuario inexistente -> 404
POST {{baseUrl}}/admin/usuarios/9999/desactivar

### Login de un usuario desactivado -> 400
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=angela&password=Angela1234!

### Login del admin otra vez -> 200
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password=Admin1234!

### Reactivar al cliente -> 200
POST {{baseUrl}}/admin/usuarios/{{nuevo.response.body.$.id}}/activar
